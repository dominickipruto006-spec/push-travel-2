# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Push World Travel - Supabase Integration Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Client-facing Supabase variables for frontend
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Initial Administrator Credentials (configured for secure /admin access)
ADMIN_EMAIL="admin@pushworldtravel.com"
ADMIN_PASSWORD="PushWorld@2026!"
ADMIN_JWT_SECRET="push-world-travel-secret-jwt-key-2026"
